[Unit]
Description=Gym Display Kiosk
After=gym-display.service
Wants=gym-display.service

[Service]
Type=simple
User=pi
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/pi/gym-display/scripts/start-kiosk.sh
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
